{\listtext	\'95	}todas as ferramentas;\
{\listtext	\'95	}todos os especialistas;\
{\listtext	\'95	}todos os templates.\
\pard\pardeftab720\sa240\partightenfactor0
\cf2 \strokec2 Isso criaria um sistema monol\'edtico.\
\pard\pardeftab720\partightenfactor0

